{
  "cleanupPeriodDays": 999999,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(/Users/bpapillon/.claude/scripts/*)",
      "Bash(awk:*)",
      "Bash(diff:*)",
      "Bash(docker logs:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(linear:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(~/.claude/scripts/*)",
      "Bsh(git diff:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:uploads.linear.app)"
    ],
    "deny": []
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/cleanup-comments.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "subtext@subtext-marketplace": true,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "subtext-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/fullstorydev/subtext.git"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "feedbackSurveyState": {
    "lastShownTime": 1754060237444
  }
}
