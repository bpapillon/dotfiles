#!/bin/zsh
# Squash-merge a PR, marking it ready first if it's a draft.
#
# Usage: pr-squash [--approve] <owner/repo> <number>
#
# Direct merge first; if checks are still pending, fall back to --auto (only
# works on repos with auto-merge enabled).

emulate -L zsh
set -e
TRAPZERR() { print; read -sk1 "?[failed - press any key]"; }

approve=0
[[ $1 == --approve ]] && { approve=1; shift }
repo=$1 num=$2
[[ -n $repo && -n $num ]] || { print -u2 "usage: pr-squash [--approve] <owner/repo> <number>"; exit 1 }

[[ $(gh pr view "$num" -R "$repo" --json isDraft -q .isDraft) == true ]] && gh pr ready "$num" -R "$repo"
(( approve )) && gh pr review "$num" -R "$repo" --approve
gh pr merge "$num" -R "$repo" --squash || gh pr merge "$num" -R "$repo" --squash --auto
