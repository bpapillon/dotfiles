#!/bin/zsh
# Rebase a PR branch onto its base and force-push. Conflicts are resolved
# headlessly by claude (/resolve-conflict skill). Runs in the branch's cw
# worktree (.claude/worktrees/<branch>) so the main checkout is untouched.
#
# Usage: pr-rebase <repo-dir> <branch> <base>

emulate -L zsh
setopt extendedglob
set -e

repo=$1 branch=$2 base=$3
[[ -n $repo && -n $branch && -n $base ]] || { print -u2 "usage: pr-rebase <repo-dir> <branch> <base>"; exit 1 }
source ~/.config/zsh/claude.zsh   # _cw_sync, _cw_copy_includes, _cw_in_use, cwdone

cd $repo
main_wt=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
dir="$main_wt/.claude/worktrees/${branch//\//-}"
existing=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0=="branch "b{print w; exit}')
[[ -n $existing ]] && dir=$existing

if [[ ! -d $dir ]]; then
  git fetch --quiet origin
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$dir" "$branch"
  else
    git worktree add --track -b "$branch" "$dir" "origin/$branch"
  fi
  _cw_copy_includes "$main_wt" "$dir"
  created=1
else
  if _cw_in_use "$dir"; then
    print -u2 "pr-rebase: $dir is in use by another session — refusing to rebase under it"
    exit 1
  fi
fi
cd $dir

_cw_sync
if [[ $(git rev-parse HEAD) != $(git rev-parse '@{u}') ]]; then
  print -u2 "pr-rebase: worktree is not in sync with origin/$branch (dirty or unpushed work) — aborting"
  exit 1
fi

git fetch --quiet origin "$base"
print "==> rebasing $branch onto origin/$base"
if ! git rebase "origin/$base"; then
  for i in {1..10}; do
    [[ -d $(git rev-parse --git-path rebase-merge) ]] || break
    print "==> conflicts, asking claude to resolve (round $i)"
    git diff --name-only --diff-filter=U
    claude -p --dangerously-skip-permissions \
      "/resolve-conflict You are running headless with nobody to prompt. After resolving every conflict and verifying the build, stage the resolved files with git add. Do NOT run git rebase --continue."
    if [[ -n $(git diff --name-only --diff-filter=U) ]] || git grep -qE '^(<<<<<<<|>>>>>>>) ' -- . ; then
      print -u2 "pr-rebase: conflicts remain after claude pass $i"
      git rebase --abort
      exit 1
    fi
    GIT_EDITOR=true git rebase --continue || true
  done
  if [[ -d $(git rev-parse --git-path rebase-merge) ]]; then
    print -u2 "pr-rebase: gave up after 10 rounds"; git rebase --abort; exit 1
  fi
fi

print "==> pushing"
git push --force-with-lease
print "==> rebased $branch onto origin/$base and pushed"

# Only tear down a worktree this run created; one that was already there is
# somebody's parked checkout. cwdone adds what the bare `git worktree remove`
# lacked: the sweep lock, so several rebases fired from the dash at once do not
# race each other's removals, and a re-check that no session has moved into the
# tree during the rebase. It exits 2 when it decides to keep the worktree, which
# is a fine outcome here — the rebase is already pushed, so cleanup must not
# fail the run (and under `set -e` it otherwise would).
if [[ -n $created ]]; then
  cd $main_wt
  cwdone "$dir" || true
fi
