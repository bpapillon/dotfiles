#!/bin/zsh
# Open a tab (or split) running `cw <branch> [-- claude args]` in <repo-dir>,
# without stealing focus from the current terminal. Lets gh-dash fire off
# several claude review sessions in parallel.
#
# Usage: cw-tab [--split] [--focus] [--base BASE] <repo-dir> <branch> [claude args...]
#        cw-tab [--split] --run <repo-dir> <title> <command> [args...]
#   --run executes <command> directly instead of `cw <branch>`.
#   --base passes a start point through to `cw <branch> BASE`.
#   --focus switches to the new tab/pane (Rex only; default leaves focus put).
#
# Backend: Rex when $REX_SESSION is set (we're inside a Rex terminal),
# otherwise Ghostty via AppleScript.
#
# Default: new tab, titled <repo>:<branch>.
# --split: first session splits the current terminal RIGHT; later sessions
#          split the most recent session DOWN, so reviews stack in a column
#          beside the dash. Panes close on clean exit and the column reflows.
# CW_TAB_DRYRUN=1 prints what it would run instead of running it.

emulate -L zsh
set -e

mode=tab run=0 base="" focus=false
while [[ $1 == --* ]]; do
  case $1 in
    --split) mode=split ;;
    --run) run=1 ;;
    --base) base=$2; shift ;;
    --focus) focus=true ;;
    *) print -u2 "cw-tab: unknown flag $1"; exit 1 ;;
  esac
  shift
done
(( $# >= 2 )) || { print -u2 "usage: cw-tab [--split] [--focus] [--base BASE] <repo-dir> <branch> [claude args...]"; exit 1 }
dir=$1 branch=$2
shift 2

# The inner zsh command. CW_INLINE=1 stops `cw` from handing off to yet
# another tab (see cw in ~/.config/zsh/claude.zsh).
if (( run )); then
  inner="${(j: :)${(q@)@}}"
else
  inner="CW_INLINE=1 cw ${(q)branch}"
  [[ -n $base ]] && inner+=" ${(q)base}"
  (( $# )) && inner+=" -- ${(j: :)${(q@)@}}"
fi
# On failure keep the pane open so the error is readable; on success it closes.
inner+=' || { print; read -sk1 "?[exited nonzero - press any key]" }'

title="${dir:t}:${branch}"
cache=${XDG_CACHE_HOME:-$HOME/.cache}/cw-tab

# ---------------------------------------------------------------- Rex backend
if [[ -n $REX_SESSION ]]; then
  rex=${commands[rex]:-"/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex"}
  # --shell=none: run zsh directly; -i inside it loads cw from ~/.zshrc.
  common=(-c "$dir" --focus=$focus --shell=none --json)
  cmd=(-- /bin/zsh -ic "$inner")

  if [[ $mode == split ]]; then
    state=$cache/rex-last-split
    anchor=$REX_BLOCK dirn=right
    # Stack below the previous session if its pane is still alive in the same
    # tab as the dash.
    if [[ -r $state ]]; then
      last=$(<$state)
      if "$rex" block ls -s "$REX_SESSION" --json 2>/dev/null | jq -e \
          --arg last "$last" --arg me "$REX_BLOCK" '
            .blocks as $b
            | ($b[] | select(.block_id == $me) | .window_id) as $w
            | any($b[]; .block_id == $last and .window_id == $w)' >/dev/null; then
        anchor=$last dirn=below
      fi
    fi
    argv=(split -s "$REX_SESSION" -b "$anchor" --split=$dirn --label "$title" $common $cmd)
    if [[ -n $CW_TAB_DRYRUN ]]; then print -r -- rex ${(q)argv}; exit; fi
    mkdir -p $cache
    "$rex" $argv | jq -r '.block_ids[0]' > $state
  else
    argv=(window new -s "$REX_SESSION" "$title" $common $cmd)
    if [[ -n $CW_TAB_DRYRUN ]]; then print -r -- rex ${(q)argv}; exit; fi
    "$rex" $argv >/dev/null
  fi
  exit
fi

# ------------------------------------------------------------ Ghostty backend
# The inner command gets wrapped in single quotes inside the Ghostty command
# string, so it must not contain any.
case $inner in (*\'*) print -u2 "cw-tab: args must not contain single quotes"; exit 1 ;; esac
cmd="/bin/zsh -ic '$inner'"

# Quote a value as an AppleScript string literal.
as() {
  local s=${1//\\/\\\\}
  print -r -- "\"${s//\"/\\\"}\""
}

state=$cache/last-split
last=""
[[ $mode == split && -r $state ]] && last=$(<$state)

script="tell application \"Ghostty\""$'\n'
script+="  set c to new surface configuration"$'\n'
script+="  set command of c to $(as "$cmd")"$'\n'
script+="  set initial working directory of c to $(as "$dir")"$'\n'
script+="  set wait after command of c to false"$'\n'
if [[ $mode == split ]]; then
  script+="  set w to window 1"$'\n'
  script+="  set src to focused terminal of selected tab of w"$'\n'
  script+="  set dir to right"$'\n'
  # Stack below the previous session if its pane is still alive in this tab.
  script+="  repeat with t in terminals of selected tab of w"$'\n'
  script+="    if id of t is $(as "$last") then"$'\n'
  script+="      set src to t"$'\n'
  script+="      set dir to down"$'\n'
  script+="    end if"$'\n'
  script+="  end repeat"$'\n'
  script+="  set dash to focused terminal of selected tab of w"$'\n'
  script+="  set n to split src direction dir with configuration c"$'\n'
  script+="  focus dash"$'\n'
  script+="  return id of n"$'\n'
else
  script+="  if (count of windows) is 0 then"$'\n'
  script+="    set t to selected tab of (new window with configuration c)"$'\n'
  script+="    perform action $(as "set_tab_title:$title") on focused terminal of t"$'\n'
  script+="  else"$'\n'
  script+="    set w to window 1"$'\n'
  script+="    set prev to selected tab of w"$'\n'
  script+="    set t to new tab in w with configuration c"$'\n'
  script+="    delay 0.2"$'\n'
  script+="    perform action $(as "set_tab_title:$title") on focused terminal of t"$'\n'
  script+="    select tab prev"$'\n'
  script+="  end if"$'\n'
fi
script+="end tell"$'\n'

if [[ -n $CW_TAB_DRYRUN ]]; then
  print -r -- "$script"
elif [[ $mode == split ]]; then
  mkdir -p $cache
  osascript -e "$script" > $state
else
  osascript -e "$script" >/dev/null
fi
